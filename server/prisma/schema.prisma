generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @db.VarChar(50)
  songs  Song[]  @relation("ArtistSongs")
  genres Genre[] @relation("GenreArtists")
}

model Genre {
  id      String   @id @default(uuid()) @db.Uuid
  type    String   @db.VarChar(50)
  artists Artist[] @relation("GenreArtists")
  songs   Song[]   @relation("GenreSongs")
}

model Song {
  id           String   @id @default(uuid()) @db.Uuid
  title        String   @db.VarChar(50)
  image        String?  @db.VarChar(255)
  audio        String   @db.VarChar(255)
  playcount    Int?
  uploadedAt   DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  artist       Artist   @relation("ArtistSongs", fields: [artistId], references: [id])
  artistId     String   @db.Uuid
  genre        Genre    @relation("GenreSongs", fields: [genreId], references: [id])
  genreId      String   @db.Uuid
  uploadedBy   User?    @relation("UploadedSongs", fields: [uploadedById], references: [id])
  uploadedById String?  @db.Uuid
  listenedBy   User[]   @relation("ListenedSongs")
  favoritedBy  User[]   @relation("FavoriteSongs")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  role          Role     @default(BASIC)
  email         String   @unique @db.VarChar(50)
  password      String   @db.VarChar(255)
  username      String   @unique @db.VarChar(50)
  registeredAt  DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  updatedAt     DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  favoriteSongs Song[]   @relation("FavoriteSongs")
  uploadedSongs Song[]   @relation("UploadedSongs")
  listenedSongs Song[]   @relation("ListenedSongs")
}

enum Role {
  ADMIN
  BASIC
}
